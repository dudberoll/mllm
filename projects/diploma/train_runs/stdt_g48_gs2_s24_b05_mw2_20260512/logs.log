```python
import cmath
import math

# Function to find the 5th roots of a complex number
def complex_nth_root(number, n):
    roots = []
    r = abs(number)
    theta = cmath.phase(number)
    for k in range(n):
        angle = (theta + 2 * math.pi * k) / n
        root = cmath.rect(r ** (1/n), angle)
        roots.append(root)
    return roots

# Solving -32 for 5th roots since x^5 = -32
coeff = -32  # Our given complex number
n = 5  # The degree of the root

roots = complex_nth_root(coeff, n)

# Filter the roots to see if the real part is positive
positive_real_roots = [root for root in roots if root.real > 0]

# Calculate the product of those roots with positive real part
product = 1
for root in positive_real_roots:
    product *= root

print((roots, positive_real_roots, product))
```
